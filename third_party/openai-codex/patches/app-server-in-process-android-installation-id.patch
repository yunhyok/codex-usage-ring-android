+#[cfg(not(target_os = "android"))]
 use codex_core::resolve_installation_id;
 use codex_exec_server::EnvironmentManager;
 use codex_feedback::CodexFeedback;
@@ -89,11 +90,14 @@ use codex_login::AuthManager;
